# Copy to /etc/resilient-routes/api.env on the EC2 instance and fill in.
# These are read by main.py to build the CORS allow-list.

# Your production frontend origin (the Vercel URL or custom domain).
FRONTEND_URL=https://your-app.vercel.app

# Any additional allowed origins, comma-separated (preview deploys, apex domain).
ALLOWED_ORIGINS=https://www.yourdomain.com
