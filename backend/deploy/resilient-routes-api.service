[Unit]
Description=Resilient Routes API (FastAPI / Uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/resilient-routes/backend
# Optional overrides (FRONTEND_URL, ALLOWED_ORIGINS) — the leading "-" makes it
# non-fatal if the file is missing.
EnvironmentFile=-/etc/resilient-routes/api.env
# Bind to localhost only; nginx terminates TLS and proxies to this port.
ExecStart=/home/ubuntu/resilient-routes/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
